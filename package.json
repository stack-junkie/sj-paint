{
  "name": "sj-paint",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Stack Junkie Paint: an independent Microsoft Paint-inspired editor for Windows and Linux.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "electron .",
    "package:linux": "npm run build && electron-builder --linux dir",
    "test": "node scripts/verify.mjs",
    "test:text": "node scripts/verify-text-workflows.mjs",
    "test:verification": "node --test scripts/verification-results.test.mjs scripts/native-fixtures.test.mjs",
    "test:print-pdf": "node scripts/verify-print-pdf.mjs",
    "test:linux": "node scripts/verify-linux.mjs",
    "test:files": "node --test electron/atomic-write.test.cjs electron/file-targets.test.cjs electron/save-file.test.cjs",
    "test:display": "node --test electron/owned-query.test.cjs electron/display-metrics.test.cjs scripts/verify-default-dimensions.mjs",
    "test:paint-format": "node --test scripts/verify-paint-format.mjs",
    "test:tiff": "node --test scripts/verify-tiff.mjs",
    "test:gif": "node --test scripts/verify-gif.mjs",
    "test:metadata": "node --test scripts/verify-image-metadata.mjs",
    "test:formats": "node --test scripts/verify-paint-format.mjs scripts/verify-tiff.mjs scripts/verify-gif.mjs scripts/verify-image-metadata.mjs",
    "test:ai-ui": "node scripts/verify-text-workflows.mjs object-mask ai-workflows generative-edits background-removal",
    "test:document-metadata": "node scripts/verify-text-workflows.mjs document-metadata file-information properties-default",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "hooks:install": "node scripts/install-hooks.mjs",
    "archive:linux": "sh scripts/archive-linux.sh",
    "installer:linux": "sh scripts/package-linux-installer.sh",
    "package:windows": "npm run build && electron-builder --win dir --x64",
    "installer:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-installer.ps1",
    "archive:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/archive-windows.ps1",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "test:windows": "node scripts/test-windows.mjs",
    "test:local-ai": "node --test electron/local-ai-process.test.cjs electron/local-ai.test.cjs electron/local-ai-service.test.cjs electron/ai-setup.test.cjs electron/ai-controller.test.cjs electron/quit-coordinator.test.cjs electron/generative-worker.test.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright-core": "1.56.1",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "io.stackjunkie.sjpaint",
    "productName": "Stack Junkie Paint",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/**/*.test.cjs",
      "src/project-format.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Graphics",
      "executableName": "sj-paint",
      "syncDesktopName": true,
      "icon": "assets/sj-paint.png"
    },
    "deb": {
      "artifactName": "sj-paint-${version}-linux-amd64.deb",
      "maintainer": "Stack-Junkie <stack-junkie@protonmail.com>",
      "packageCategory": "graphics"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/sj-paint.ico"
    },
    "nsis": {
      "artifactName": "sj-paint-${version}-windows-x64-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SJ Paint",
      "packElevateHelper": false,
      "include": "build/installer.nsh",
      "installerIcon": "assets/sj-paint.ico",
      "uninstallerIcon": "assets/sj-paint.ico"
    }
  },
  "license": "MIT",
  "author": "Stack Junkie",
  "repository": {
    "type": "git",
    "url": "https://github.com/stack-junkie/sj-paint.git"
  },
  "bugs": {
    "url": "https://github.com/stack-junkie/sj-paint/issues"
  },
  "homepage": "https://github.com/stack-junkie/sj-paint#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "io.stackjunkie.sjpaint.desktop",
  "dependencies": {
    "tar": "7.5.22"
  }
}
